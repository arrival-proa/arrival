# Copie para .env.local e preencha. O .env.local NUNCA vai para o GitHub.
# Gerar texto aleatório para os tokens:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Gemini (Google AI Studio → Get API key). Cada dev usa a própria chave.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=

# SerpApi (painel da SerpApi). No dia a dia, deixe USE_MOCK=true.
SERPAPI_KEY=
USE_MOCK=true

# Supabase (Project Settings → API Keys / botão Connect)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Servidor MCP (local: http://localhost:3000/api/mcp)
MCP_SERVER_URL=http://localhost:3000/api/mcp
MCP_SERVER_TOKEN=

# Cron de keep-alive
CRON_SECRET=

# Os limites de roteiros e buscas de cada plano ficam no banco:
# função limites_do_plano() em supabase/schema.sql
